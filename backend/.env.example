# Backend-only values. Never prefix these with VITE_ and never commit backend/.env.
SUPABASE_URL=https://your-project.supabase.co
# Use Supabase Dashboard > Settings > API > Secret key / service_role key here.
# Copy the complete key exactly; do not use a publishable/anon key.
# The browser publishable/anon key cannot perform server CRUD with the current RLS policies.
SUPABASE_KEY=replace-with-supabase-service-role-key
# Comma-separated allowlist. Add the deployed Vercel domain in production.
FRONTEND_ORIGIN=http://localhost:5173,https://your-project.vercel.app